{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structuredcontext.dev/schema/scd.meta.schema.json",
  "title": "SCS Meta-Tier SCD",
  "description": "Schema for Meta-Tier Structured Context Documents (SCDs).",
  "type": "object",
  "required": ["id", "type", "title", "version", "description", "content", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^scd:meta:[a-zA-Z0-9._-]+$"
    },
    "type": {
      "type": "string",
      "const": "meta"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "pattern": "^concept:[a-z][a-z0-9-]*$",
      "description": "Optional: the domain concept this SCD realizes (RFC-0001 Domain Ontology). Expected for SCDs in a concept bundle."
    },
    "content": {
      "type": "object",
      "description": "Meta-level definitions: roles, capabilities, domains, concepts, etc.",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^role:[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trust_level": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^capability:[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "related_domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^domain:[a-zA-Z0-9._-]+$"
                }
              },
              "primary_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^role:[a-zA-Z0-9._-]+$"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^domain:[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^concept:[a-zA-Z0-9._-]+$"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "applies_to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "directives": {
        "type": "array",
        "description": "Plain-language statements an agent is expected to follow; the only SCD content compiled into a runtime artifact (spec/0.6/runtime-artifact.md). Distinct from rules, which references external rule sets for enforcement.",
        "items": {
          "type": "object",
          "required": ["id", "directive"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "Unique within the SCD; compiled to the rule id <bundle-name>/<scd-name>/<id>"
            },
            "directive": {
              "type": "string",
              "minLength": 1
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^std:[a-z0-9][a-z0-9.-]*(:[A-Za-z0-9.-]+)?(#[A-Za-z0-9.()_-]+)?$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "rules": {
          "type": "object",
          "description": "References to external rule sets stored in Rules Database",
          "properties": {
            "rule_set_id": {
              "type": "string",
              "description": "Reference to rule set in Rules Database (e.g., 'pa-drugs-v2.3')",
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "rule_set_type": {
              "type": "string",
              "description": "Type of rules (e.g., 'prior-auth', 'approval', 'security')"
            },
            "schema_version": {
              "type": "string",
              "description": "Version of rule schema this SCD expects"
            },
            "description": {
              "type": "string",
              "description": "Description of how these rules are used"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "cites": {
      "type": "array",
      "description": "Optional standard citation references (citations.md): edition and clause only, never standard text.",
      "items": {
        "type": "string",
        "pattern": "^std:[a-z0-9][a-z0-9.-]*(:[A-Za-z0-9.-]+)?(#[A-Za-z0-9.()_-]+)?$"
      }
    },
    "relationships": {
      "type": "array",
      "description": "Optional relationships to other SCDs.",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "pattern": "^(scd:(meta|standards|project):[a-zA-Z0-9._-]+|std:[a-z0-9][a-z0-9.-]*(:[A-Za-z0-9.-]+)?(#[A-Za-z0-9.()_-]+)?)$",
            "description": "An scd: id, or (for satisfies) a std: citation reference (citations.md). scd:standards: targets are deprecated in 0.6.0."
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_by", "created_at"],
      "properties": {
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_by": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
