{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structuredcontext.dev/schema/scd.project.schema.json",
  "title": "SCS Project-Tier SCD",
  "description": "Schema for Project-Tier Structured Context Documents (SCDs).",
  "type": "object",
  "required": ["id", "type", "title", "version", "description", "content", "provenance"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^scd:project:[a-zA-Z0-9._-]+$"
    },
    "type": {
      "type": "string",
      "const": "project"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "pattern": "^concept:[a-z][a-z0-9-]*$",
      "description": "Optional: the domain concept this SCD realizes (RFC-0001 Domain Ontology). Expected for SCDs in a concept bundle."
    },
    "content": {
      "type": "object",
      "description": "Project-specific system context: architecture, requirements, flows, etc.",
      "properties": {
        "architecture": {
          "type": "object",
          "properties": {
            "architecture_style": {
              "type": "string"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "description"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^component:[a-zA-Z0-9._-]+$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "responsibilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "interfaces": {
                    "type": "object",
                    "properties": {
                      "inputs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "outputs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": true
                  },
                  "runtime_env": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability_id"],
            "properties": {
              "capability_id": {
                "type": "string",
                "pattern": "^capability:[a-zA-Z0-9._-]+$"
              },
              "implemented_by": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^component:[a-zA-Z0-9._-]+$"
                }
              },
              "related_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^role:[a-zA-Z0-9._-]+$"
                }
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "description"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^req:[a-zA-Z0-9._-]+$"
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "constraint": {
                "type": "string"
              },
              "related_components": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^component:[a-zA-Z0-9._-]+$"
                }
              },
              "related_standards": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^scd:standards:[a-zA-Z0-9._-]+$"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "data_flows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "path"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^flow:[a-zA-Z0-9._-]+$"
              },
              "description": {
                "type": "string"
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^component:[a-zA-Z0-9._-]+$"
                }
              },
              "data_classification": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "security_controls": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "description"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^sec:[a-zA-Z0-9._-]+$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "requirement_level": {
                    "type": "string"
                  },
                  "maps_to": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^scd:standards:[a-zA-Z0-9._-]+$"
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "rationale"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^decision:[a-zA-Z0-9._-]+$"
              },
              "title": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "related_components": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^component:[a-zA-Z0-9._-]+$"
                }
              },
              "related_requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^req:[a-zA-Z0-9._-]+$"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "directives": {
        "type": "array",
        "description": "Plain-language statements an agent is expected to follow; compiled into a runtime artifact's rules (spec/0.6/runtime-artifact.md). Distinct from rules, which references external rule sets for enforcement.",
        "items": {
          "type": "object",
          "required": ["id", "directive"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "Unique within the SCD across directives, prohibitions, and facts; compiled to the rule id <bundle-name>/<scd-name>/<id>"
            },
            "directive": {
              "type": "string",
              "minLength": 1
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^std:[a-z0-9][a-z0-9.-]*(:[A-Za-z0-9.-]+)?(#[A-Za-z0-9.()_-]+)?$"
              }
            },
            "derived_from": {
              "type": "array",
              "description": "Where this item came from (RFC 0002 section 5): an intake answer or a source document in the workspace's intake.yaml. For reviewers; not compiled",
              "items": {
                "type": "object",
                "oneOf": [
                  {"required": ["intake"]},
                  {"required": ["source"]}
                ],
                "properties": {
                  "intake": {"type": "string", "minLength": 1, "description": "An answers[].id"},
                  "source": {"type": "string", "minLength": 1, "description": "A source_documents[].id"},
                  "locator": {"type": "string", "minLength": 1, "description": "Where in the source, such as a section"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "prohibitions": {
        "type": "array",
        "description": "Binary prohibitions: tools or practices that are forbidden, with no conditions. Compiled into rules ahead of directives (spec/0.6/runtime-artifact.md).",
        "items": {
          "type": "object",
          "required": ["id", "kind", "subject"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "Unique within the SCD across directives, prohibitions, and facts; compiled to <bundle-name>/<scd-name>/<id>"
            },
            "kind": {
              "type": "string",
              "enum": ["tool", "practice"],
              "description": "tool: a product, service, library, or model; practice: an action"
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "description": "What is prohibited, as a noun phrase, without conditions or qualifiers (e.g. 'public LLM services')"
            },
            "instead": {
              "type": "string",
              "minLength": 1,
              "description": "The approved alternative, if any; compiled"
            },
            "reason": {
              "type": "string",
              "description": "Why it is prohibited; for reviewers, not compiled"
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^std:[a-z0-9][a-z0-9.-]*(:[A-Za-z0-9.-]+)?(#[A-Za-z0-9.()_-]+)?$"
              }
            },
            "derived_from": {
              "type": "array",
              "description": "Where this item came from (RFC 0002 section 5): an intake answer or a source document in the workspace's intake.yaml. For reviewers; not compiled",
              "items": {
                "type": "object",
                "oneOf": [
                  {"required": ["intake"]},
                  {"required": ["source"]}
                ],
                "properties": {
                  "intake": {"type": "string", "minLength": 1, "description": "An answers[].id"},
                  "source": {"type": "string", "minLength": 1, "description": "A source_documents[].id"},
                  "locator": {"type": "string", "minLength": 1, "description": "Where in the source, such as a section"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "facts": {
        "type": "array",
        "description": "Statements of fact an agent should know (company, architecture, environment). Compiled into the artifact's facts list (spec/0.6/runtime-artifact.md).",
        "items": {
          "type": "object",
          "required": ["id", "fact"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "Unique within the SCD across directives, prohibitions, and facts; compiled to <bundle-name>/<scd-name>/<id>"
            },
            "fact": {
              "type": "string",
              "minLength": 1
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^std:[a-z0-9][a-z0-9.-]*(:[A-Za-z0-9.-]+)?(#[A-Za-z0-9.()_-]+)?$"
              }
            },
            "derived_from": {
              "type": "array",
              "description": "Where this item came from (RFC 0002 section 5): an intake answer or a source document in the workspace's intake.yaml. For reviewers; not compiled",
              "items": {
                "type": "object",
                "oneOf": [
                  {"required": ["intake"]},
                  {"required": ["source"]}
                ],
                "properties": {
                  "intake": {"type": "string", "minLength": 1, "description": "An answers[].id"},
                  "source": {"type": "string", "minLength": 1, "description": "A source_documents[].id"},
                  "locator": {"type": "string", "minLength": 1, "description": "Where in the source, such as a section"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "rules": {
          "type": "object",
          "description": "References to external rule sets stored in Rules Database",
          "properties": {
            "rule_set_id": {
              "type": "string",
              "description": "Reference to rule set in Rules Database (e.g., 'pa-drugs-v2.3')",
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "rule_set_type": {
              "type": "string",
              "description": "Type of rules (e.g., 'prior-auth', 'approval', 'security')"
            },
            "schema_version": {
              "type": "string",
              "description": "Version of rule schema this SCD expects"
            },
            "description": {
              "type": "string",
              "description": "Description of how these rules are used"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "cites": {
      "type": "array",
      "description": "Optional standard citation references (citations.md): edition and clause only, never standard text.",
      "items": {
        "type": "string",
        "pattern": "^std:[a-z0-9][a-z0-9.-]*(:[A-Za-z0-9.-]+)?(#[A-Za-z0-9.()_-]+)?$"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "pattern": "^(scd:(meta|standards|project):[a-zA-Z0-9._-]+|std:[a-z0-9][a-z0-9.-]*(:[A-Za-z0-9.-]+)?(#[A-Za-z0-9.()_-]+)?)$",
            "description": "An scd: id, or (for satisfies) a std: citation reference (citations.md). scd:standards: targets are deprecated in 0.6.0."
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_by", "created_at"],
      "properties": {
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_by": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}